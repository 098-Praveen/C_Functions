int func(int a[],int n,int *ecount,int *ocount)
{
    int i;
    for(i=0;i<n;i++)
    {
        if(a[i]%2==0)
        {
            *ecount++;
        }
        else
        {
            *ecount++;
        }
    }
}
int main()
{
    int even=0,odd=0;
    int a[]={1,2,3,4,5,6,7};
    int n=sizeof(a)/sizeof(a[0]);
    func(a,n,&even,&odd);
