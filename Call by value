#include <stdio.h>

void change(int *p, int *q)
{
    *p = 100;
    *q = 200;
}

int main(void)
{
    int a = 10, b = 20;

    change(&a, &b);

    printf("a = %d, b = %d\n", a, b);

    return 0;
}
a=100,b=200

#include <stdio.h>

void change(int *p, int *q)
{
    int temp = *p;
    *p = *q;
    *q = temp;
}

int main(void)
{
    int a = 10, b = 20;

    change(&a, &b);

    printf("a = %d, b = %d\n", a, b);

    return 0;
}
a=20,b=10.

#include <stdio.h>

void change(int *p, int *q)
{
    *p = *p + *q;
    *q = *p - *q;
    *p = *p - *q;
}

int main(void)
{
    int a = 5, b = 3;

    change(&a, &b);

    printf("a = %d, b = %d\n", a, b);

    return 0;
}

a=3,b=5

