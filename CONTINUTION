FINDING LARGEST ELEMENT IN ARRAY:

  #include<stdio.h>
int findmax(int arr[],int n)
{
    int max=0;
    for(int i=0;i<n;i++)
    {
        if(arr[max]<arr[i])
        {
            max=i;
        }
    }
    return arr[max];
}

int main()
{
    int a[]={10,30,20,50,40};
    int max=findmax(a,5);
    printf("%d ",max);
    return 0;
}
ANOTHER CODE :
#include<stdio.h>
int findmax(int arr[],int n)
{
    int max=arr[0];
    for(int i=0;i<n;i++)
    {
        if(arr[i]>max)
        {
            max=arr[i];
        }
    }
    return max;
}

int main()
{
    int a[]={10,900,20,80,40};
