    printf("%d ",max);
    return 0;
}
FINDING MINIMUM:

#include<stdio.h>
int findmin(int arr[],int n)
{
    int small=arr[0];
    for(int i=0;i<n;i++)
    {
        if(small>arr[i])
        {
            small=arr[i];
        }
    }
    return small;
}
int main()
{
    int a[]={30,45,35,25,67};
    
    int small=findmin(a,5);
    printf("%d ",small);
    return 0;
}
