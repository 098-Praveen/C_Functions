CALL BY VALUE:

call by value means passing a copy of a variable's value to the function.
function receives copy not original variable itself.
  
#include <stdio.h>

void change(int num)
{
    num = 100;
}

int main(void)
{
    int x = 10;

    change(x);

    printf("%d\n", x);

    return 0;
}
x=10.
