#include <stdio.h>

void change(int *num)
{
    int x = 200;
    num = &x;
}

int main(void)
{
    int x = 10;

    change(&x);

    printf("%d\n", x);

    return 0;
}
x is 10
changing the local pointer num does not change the original pointer or variable in main.
  
  
  #include <stdio.h>

void change(int *num)
{
    *num = 200;
}

int main(void)
{
    int x = 10;

    change(&x);
    change(&x);

    printf("%d\n", x);

