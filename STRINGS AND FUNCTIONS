STRING LENGTH USING A FUNCTIONS:

#include<stdio.h>
int strlength(char ptr[])
{
    int i,count=0;
    for(i=0;ptr[i];i++)
    {
        count++;
    }
    return count;
}
int main()
{
    char str[]="praveen";
    int count=strlength(str);
    printf("%d",count);
    return 0;
}

Program 2: String Reverse Using a Function
Write a C program that:
1. Declares a string in main().
2. Passes it to a function named reverse().
3. Reverses the string inside that function.
4. Prints the reversed string in main().

Input:  praveen
Output: neevarp

    #include<stdio.h>
#include<string.h>
void reverse(char ptr[],int n)
{
    int i,j;
    char temp;
    for(i=0,j=n-1;i<=j;i++,j--)
    {
        temp=ptr[i];
        ptr[i]=ptr[j];
        ptr[j]=temp;
    }
   
}
int main()
{
    char str[]="praveen";
    int n=strlen(str);
    reverse(str,n);
    for(int i=0;i<n;i++)
    {
        printf("%c ",str[i]);
    }
    return 0;
}

STRING COMPARISON:

#include<stdio.h>
#include<string.h>
int stcmp(char ptr1[],char ptr2[])
{
    int i,found=1;
    for(i=0;ptr1[i];i++)
    {
        if(ptr1[i]!=ptr2[i])
        {
            found=0;
            break;
        }
    }
    if(ptr1[i]!=ptr2[i])
    {
        found=0;
    }
    return found;
}
int main()
{
    char str1[]="hell";
    char str2[]="hello";
    int ret=stcmp(str1,str2);
    printf("%d",ret);
    return 0;
}


